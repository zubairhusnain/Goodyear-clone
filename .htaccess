# Goodyear offline — Apache front controller (cPanel: enable mod_rewrite).
# If the site URL is https://example.com/subfolder/ uncomment RewriteBase below.

<IfModule mod_rewrite.c>
RewriteEngine On

# Site in a subdirectory? Match the URL path (leading slash, no trailing slash):
# RewriteBase /subfolder

Options -MultiViews
DirectoryIndex index.php

# Block direct access to internal PHP tree
RewriteRule ^pages/ - [F,L]

# Serve real files (assets, images, CSS, JS, Scene7 files, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# Clean URLs → router.php
RewriteRule ^ router.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
DirectoryIndex index.php
</IfModule>

# Optional: set install path when auto-detect is wrong (no trailing slash; empty = domain root)
# SetEnv GY_BASE_PATH /subfolder
